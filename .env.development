# Used only to build the MCP connection URL shown after generating a key (McpKeyModal.tsx).
# External MCP clients (Claude Desktop, Cursor, CLI tools) talk to the backend directly - they are not
# the browser page, so they never go through Vite's dev-only /api proxy. In dev the frontend (5173) and
# backend (8080) are different ports, so this must point at the backend explicitly.
VITE_BACKEND_ORIGIN=http://localhost:8080
