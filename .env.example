# The backend's origin. Leave unset for local dev (Vite proxies /api same-origin, see vite.config.ts).
# Set this in Vercel's project env vars for production, e.g. https://synapsemcp.onrender.com
# (no trailing slash, no /api/v1 suffix).
VITE_API_BASE_URL=

# Used only to build the MCP connection URL shown in "Connect External LLM" after a key is generated.
# Same value as VITE_API_BASE_URL in most deployments.
VITE_BACKEND_ORIGIN=
